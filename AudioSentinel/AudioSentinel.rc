#include <windows.h>
#include "resource.h"

IDI_APP ICON "AudioSentinel.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Afaguayo"
            VALUE "FileDescription", "AudioSentinel - safe listening monitor"
            VALUE "FileVersion", "1.2.0"
            VALUE "InternalName", "AudioSentinel"
            VALUE "OriginalFilename", "AudioSentinel.exe"
            VALUE "ProductName", "AudioSentinel"
            VALUE "ProductVersion", "1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
